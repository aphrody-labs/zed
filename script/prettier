#!/bin/bash
set -euxo pipefail

PRETTIER_VERSION=3.5.0

# bun first; pnpm remains the fallback for CI images without bun
if command -v bunx >/dev/null 2>&1; then
    DLX=(bunx)
else
    DLX=(pnpm dlx)
fi

if [[ "${1:-}" == "--write" ]]; then
    MODE="--write"
else
    MODE="--check"
fi

"${DLX[@]}" "prettier@${PRETTIER_VERSION}" assets/settings/default.json --parser=jsonc $MODE || {
    echo "To fix, run from the root of the Zed repo:"
    echo "  bunx prettier@${PRETTIER_VERSION} assets/settings/default.json --parser=jsonc --write"
    false
}

cd docs
"${DLX[@]}" "prettier@${PRETTIER_VERSION}" . $MODE || {
    echo "To fix, run from the root of the Zed repo:"
    echo "  cd docs && bunx prettier@${PRETTIER_VERSION} . --write && cd .."
    false
}
